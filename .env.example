# ─────────────────────────────────────────────────────────────
# inferLab — server configuration
# Copy to `.env`. These are read ONLY by the Node backend and take
# precedence over variables exported in your shell. They are never bundled
# into the browser build. Keys can also be entered in the app's Settings
# drawer for a single browser session (kept in memory, sent per request).
# ─────────────────────────────────────────────────────────────

# Anthropic (Claude)
ANTHROPIC_API_KEY=<REDACTED>
# Model used by the Claude provider. Any current Claude model id works.
ANTHROPIC_MODEL=claude-opus-5
# Only needed when your key is an organization-level key that is not scoped to
# a workspace (the API then demands an anthropic-workspace-id header).
# Workspace-scoped keys created in the Anthropic Console do not need this.
ANTHROPIC_WORKSPACE_ID=
# Server-side refusal fallbacks (beta). Set to "off" to disable.
ANTHROPIC_FALLBACKS=on

# OpenAI
OPENAI_API_KEY=<REDACTED>
# Model used by the OpenAI provider. The lab requests `logprobs` so the
# probability stage can show REAL next-token alternatives; models that reject
# logprobs or temperature are retried without them and the UI says so.
OPENAI_MODEL=gpt-5.6

# Google Gemini. Either variable works; GOOGLE_API_KEY wins if both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# GitHub Product Analyzer. Public repositories work without a token. To analyze
# your PRIVATE repositories, add a token with read access to Contents (a
# fine-grained token scoped to those repos is ideal). A token also raises the
# API limit from 60 to 5,000 requests per hour. It is never sent to the browser
# and can also be entered per browser in Settings → API keys.
GITHUB_TOKEN=

# RAG Visualizer. No extra variables: document embeddings use OPENAI_API_KEY
# (text-embedding-3-small/large) or GEMINI_API_KEY (gemini-embedding-001) when
# present, and a local hashed n-gram embedding otherwise, which the UI labels as
# a stand-in. Uploaded documents, chunks and vectors live only in the server's
# memory and are dropped two hours after last use; nothing is written to disk.

# Backend port (Vite dev server proxies /api here)
API_PORT=8790

# Offline demo provider (development only). Adds a "Offline demo" model that
# streams a canned answer with NO network calls, so the visualizer can be
# explored without keys. Everything it reports is synthetic and is labelled
# as such in the UI. Leave unset/off for real deployments.
LLM_MOCK_PROVIDER=off
